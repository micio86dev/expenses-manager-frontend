#!/usr/bin/env bash
# Runs lint and typecheck when staged changes touch sources, tests or configuration.
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
pattern='^(src/|tests/|e2e/|scripts/|[^/]+\.(ts|js|mjs|json|vue|css)$|\.prettierrc|\.env\.example)'

if echo "$staged" | grep -Eq "$pattern"; then
    make lint
    make typecheck
fi

# Guardian Angel review of the staged files runs last, after the checks above.
# `gga install` is not used because core.hooksPath points here.
if command -v gga >/dev/null 2>&1; then
    gga run
else
    echo "pre-commit: gga not found, skipping the Guardian Angel review (brew install gentleman-programming/tap/gga)" >&2
fi
